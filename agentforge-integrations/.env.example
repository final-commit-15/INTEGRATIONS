# ------------------------------
# AgentForge Integrations - Environment Variables
# ------------------------------

# General
LOG_LEVEL=INFO
ENCRYPTION_KEY=your-32-byte-fernet-key-base64-encoded-

# GitHub
INTEGRATION_GITHUB_API_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Jira
INTEGRATION_JIRA_BASE_URL=https://your-domain.atlassian.net
INTEGRATION_JIRA_API_TOKEN=your_jira_api_token
INTEGRATION_JIRA_EMAIL=your-email@example.com
JIRA_WEBHOOK_SECRET=your_jira_webhook_secret

# Slack
INTEGRATION_SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
INTEGRATION_SLACK_SIGNING_SECRET=xxxxxxxxxxxx

# Microsoft Teams
INTEGRATION_TEAMS_WEBHOOK_URL=https://your.webhook.url
INTEGRATION_TEAMS_CLIENT_ID=your_client_id
INTEGRATION_TEAMS_CLIENT_SECRET=your_client_secret

# Documentation (Generic Git or S3)
INTEGRATION_DOCUMENTATION_REPO_URL=https://github.com/org/docs
INTEGRATION_DOCUMENTATION_API_TOKEN=ghp_yyyyyyyy