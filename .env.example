# =============================================================================
# AgentForge Integrations - Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Service ---
ENVIRONMENT=development
DEBUG=false
APP_NAME=agentforge-integrations
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=4

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentforge
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_TOKEN_CACHE_TTL=300
REDIS_WEBHOOK_TTL=86400

# --- Security / Crypto ---
# Fernet key - generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Old key used during rotation (comma separated for multiple)
ENCRYPTION_KEY_PREVIOUS=
# 256-bit key for HMAC hashing of credentials - generate with: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_HASH_SALT=

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_WEBHOOK=120/minute
RATE_LIMIT_OAUTH=10/minute

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=agentforge-integrations
OTEL_TRACES_SAMPLE_RATIO=0.1

# --- OAuth Redirect ---
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Provider Credentials
# =============================================================================

# --- Google Workspace (Gmail, Drive, Calendar, Docs, Sheets) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=openid,email,profile,gmail.readonly,gmail.send,gmail.modify,drive,drive.file,calendar,calendar.events,documents,spreadsheets

# --- Slack ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SCOPES=channels:read,channels:manage,chat:write,users:read,reactions:write,files:write,im:history,mpim:read,groups:read

# --- GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_SCOPES=repo,read:org,workflow,user:email

# --- Notion ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_SCOPES=read_content,write_content

# --- Discord ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_SCOPES=bot,identify,guilds,guilds.join

# --- Jira / Atlassian ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_API_TOKEN=
JIRA_SITE_URL=https://your-domain.atlassian.net
JIRA_SCOPES=read:jira-user,offline_access

# --- Trello ---
TRELLO_API_KEY=
TRELLO_API_TOKEN=

# --- Airtable ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# --- HubSpot ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SCOPES=oauth,crm.objects.contacts.read,crm.objects.deals.read,crm.objects.companies.read,crm.schemas.contacts.read

# --- Salesforce ---
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=
SALESFORCE_EMAIL=
SALESFORCE_PASSWORD=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WEBHOOK_SECRET=

# --- SendGrid ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=AgentForge

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- AWS S3 ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# --- Dropbox ---
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- OneDrive / Microsoft ---
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_SCOPES=files.readwrite.all

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017

# --- Twilio Verify Service (OTP) ---
TWILIO_OTP_VERIFY_SID=

# --- Webhook default ---
WEBHOOK_DEFAULT_SECRET=
WEBHOOK_RETRY_MAX=5
WEBHOOK_RETRY_BACKOFF_BASE=2
WEBHOOK_POLL_INTERVAL_SECONDS=60